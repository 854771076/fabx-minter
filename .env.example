# 链与接口
FABX_RPC_URL=https://rpc.xmake.org/rpc/196
FABX_CHAIN_ID=196
FABX_API_URL=https://api.fabx.tech

# 合约地址（来自前端产物 config-BhXPazbF.js 的 VITE_* 变量，2026-10 v2 部署）
# 站点会「整站重新部署」并更换全套地址；旧工厂 0x138fA3B3… 的两个 CPU 均已售罄，
# 只有新工厂下才有额度。地址变了就覆盖下面这些变量。
FABX_CIRCUIT_FACTORY_ADDRESS=0x82935793a854fA2F2e8A9d2B3F17BbfBf81D6C05
FABX_MARKETPLACE_ADDRESS=0x7F955C233FDb17e98FB26F330D778D3E30fe6Ee6
FABX_CIRCUIT_MARKET_ADDRESS=0x0BC37F95aE57bb20e995D425d46D6df9f22Bd7a1
FABX_POD_MINING_ADDRESS=0xB6d4d03e9DfD3aD4889241e23F12EA4557696018
FABX_XMAKE_ADDRESS=0xC8c0D268563F59D6cA3A42C48450A6A8Af399843
# PoD 深度挖矿配套地址（与上面同批取自前端 config-*.js）
# PodLens 是只读透镜（任务参考/采样/预估）；EmissionSwitch 控制产出开关
FABX_POD_LENS_ADDRESS=0xf63aFD2D7AFCff789882d9C2Ee3a56efffc2301d
FABX_EMISSION_SWITCH_ADDRESS=0xb8eA0c234b85Ee76e580240726345ea5C0844945
# 默认挖矿目标：RefBench（当前唯一仍可铸晶体管、挖矿倍率为 1 的处理器族）
FABX_DEFAULT_CIRCUITS_ADDRESS=0x265E2580cB9c3FC059f2AA3cf20ad30F3F0A653C
FABX_DEFAULT_TRANSISTORS_ADDRESS=0x158341E42F00f658C86e3d42bC4c397Df16795DA

# 存储与密钥
FABX_DB_PATH=var/fabx.db
# 私钥加密口令：留空则从 FABX_SECRET 或交互式输入读取，绝不写入数据库
FABX_SECRET=

# 执行参数
FABX_CONCURRENCY=5
# 同一账号内「连续广播、稍后统一等回执」的交易条数；1 = 逐笔等待
FABX_PIPELINE_TXS=4
FABX_GAS_LIMIT=0
FABX_GAS_PRICE_GWEI=0
FABX_GAS_MULTIPLIER=1.15
# 动态 gas 上限（gwei）：拥堵时 gas 价超过该值就跳过，0 表示不设上限
FABX_GAS_PRICE_MAX_GWEI=0
# 广播后超过该秒数仍未打包，就按下面两项加价替换（用同一 nonce 重发）解拥堵
FABX_PENDING_TIMEOUT=45
FABX_GAS_BUMP_PERCENT=20
FABX_GAS_BUMP_MAX_ATTEMPTS=2
FABX_TX_TIMEOUT=180
FABX_MAX_RETRIES=2

# PoD 挖矿（tapeout / arm / start / claim）
# tapeout 固定费用（wei）；0 = 不本地校验，直接按合约实时 TAPEOUT_FEE 支付
FABX_TAPEOUT_FEE_WEI=0
# tapeout / arm / claim / stop 的 gas 上限；0 = 走链上估算
FABX_MINE_GAS_LIMIT=0
# start 要在链上重放全部样本，gas 波动大，这里给固定上限兜底
FABX_MINE_START_GAS_LIMIT=1500000
# 设计盐（bytes32 hex，防抢跑）；留空则现场随机生成并写入 SQLite
FABX_MINE_SALT=
# arm 之后等待「采样锚点区块」出现的轮询间隔（秒）与超时（秒）
FABX_MINE_POLL_INTERVAL=2.0
FABX_MINE_ARM_TIMEOUT=60

# Web 控制台
FABX_WEB_HOST=127.0.0.1
FABX_WEB_PORT=8787
# 访问令牌：监听非回环地址（如 0.0.0.0）时必填，所有 /api 请求都要带 X-FABX-Token
FABX_WEB_TOKEN=
