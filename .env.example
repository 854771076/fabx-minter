# 链与接口
FABX_RPC_URL=https://rpc.xmake.org/rpc/196
FABX_CHAIN_ID=196
FABX_API_URL=https://api.fabx.tech

# 合约地址（来自前端产物 config-DJaFdDfO.js 的 VITE_* 变量）
FABX_CIRCUIT_FACTORY_ADDRESS=0x138fA3B38b1461B5908C455ABD30fC55029b7e71
FABX_MARKETPLACE_ADDRESS=0xF48DD28A992f891D781dFBEe59Ab03dDAfD5a02C
FABX_CIRCUIT_MARKET_ADDRESS=0x1ca1C665a7630560E237c010F879b59086D715BB
FABX_POD_MINING_ADDRESS=0x37E1518Dd3c5A173Ca4773F3b252440c10FAe9D1
FABX_XMAKE_ADDRESS=0x551630E595789b7e91948368c1b751404b5d75ab

# 存储与密钥
FABX_DB_PATH=var/fabx.db
# 私钥加密口令：留空则从 FABX_SECRET 或交互式输入读取，绝不写入数据库
FABX_SECRET=

# 执行参数
FABX_CONCURRENCY=5
FABX_GAS_LIMIT=0
FABX_GAS_PRICE_GWEI=0
FABX_GAS_MULTIPLIER=1.15
FABX_TX_TIMEOUT=180
FABX_MAX_RETRIES=2

# Web 控制台
FABX_WEB_HOST=127.0.0.1
FABX_WEB_PORT=8787
# 访问令牌：监听非回环地址（如 0.0.0.0）时必填，所有 /api 请求都要带 X-FABX-Token
FABX_WEB_TOKEN=
